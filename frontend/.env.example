# Copy this file to `.env` and change values per environment.
# Only variables starting with VITE_ are exposed to the browser.
#
# LOCAL DEVELOPMENT: leave VITE_API_BASE_URL unset.
# The app then calls "/api", and the Vite dev proxy (see vite.config.js) forwards
# those requests to Spring Boot on http://localhost:8080. Because the browser only
# talks to localhost:3000, there are no CORS errors.
#
# PRODUCTION: set it to the deployed backend, for example:
# VITE_API_BASE_URL=https://your-backend.example.com/api
